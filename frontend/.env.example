# Navneet ERP - Frontend Environment Configuration

# -------------------------------------------------------------
# 1. REAL BACKEND MODE (FastAPI, Django, Node.js, Express, etc.)
# -------------------------------------------------------------
# Set your real backend server URL (e.g. http://localhost:8000 or production domain)
VITE_API_URL=http://localhost:8001

# Set to "false" to disable the in-browser mock interceptor and send live HTTP requests:
VITE_USE_MOCK=false

# -------------------------------------------------------------
# 2. LOCAL OFFLINE / MOCK DEMO MODE (Legacy only)
# -------------------------------------------------------------
# The application is configured for the real FastAPI backend by default.
# Mock data is not initialized by the frontend entrypoint.
