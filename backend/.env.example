DATABASE_URL=postgresql://postgres:postgres@localhost:5432/navneet_samp
APP_NAME="Navneet SAMP ERP API"
APP_ENV=development
DEBUG=True
HOST=0.0.0.0
PORT=8001
CORS_ORIGINS=["http://localhost:5173","http://localhost:5175"]

# JWT & Session Security
# PRODUCTION: Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# NEVER use the placeholder below in production — app will refuse to start.
JWT_SECRET_KEY=REPLACE_WITH_64_CHAR_HEX_SECRET
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Brute-Force Rate Limiting
RATE_LIMIT_LOGIN_MAX_ATTEMPTS=5
RATE_LIMIT_LOGIN_WINDOW_SECONDS=60
